@page "/placar"

<h1>Placar: @pontos</h1>

<button @onclick="SomarPonto">Somar 1 Ponto</button>

<button @onclick="SubtrairPonto">Subtrair 1 Ponto</button>

<button @onclick="ZerarPlacar">Zerar Placar</button>

@code {
    private int pontos = 0;

    private void SomarPonto()
    {
        pontos++;
    }

    private void SubtrairPonto()
    {
        if (pontos > 0)
        {
            pontos--;
        }
    }

    private void ZerarPlacar()
    {
        pontos = 0;
    }
}
